# ==========================================
# RAMDOOT Foundation - Environment Config
# ==========================================
# Copy this to .env and fill in your values
# ==========================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=RAMDOOT Backend
API_PREFIX=api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://ramdoot:ramdoot123@localhost:5432/ramdoot_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ramdoot-publications

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@ramdoot.com

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Encryption (for sensitive fields like bank account numbers)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Upload
MAX_FILE_SIZE=10485760
