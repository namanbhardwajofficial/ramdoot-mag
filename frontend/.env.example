# Frontend configuration (loaded by Vite).
# Copy to `.env` and fill in. Only VITE_* variables are exposed to the browser —
# never put a secret here, anything in this file ships in the built bundle.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Backend origin. No trailing slash. The API client appends the `/api/v1` path
# itself (see src/lib/api.js), so give the origin only.
#
# MUST be https:// in production. The browser blocks http:// API calls from an
# https:// page as mixed content, which breaks every request in the app.
#
# In development this is also the proxy target: src/config/constants.js blanks
# the API origin so requests go out same-origin and Vite forwards them
# server-side (see the `proxy` block in vite.config.js). That exists because the
# deployed backend's CORS_ORIGINS allowlist does not include localhost.
# ---------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Razorpay publishable key id (the `rzp_...` value, NOT the key secret).
#
# Optional: /payments/create-order returns the key it opened the order with and
# the checkout prefers that, so this is only a fallback. The backend must have
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET configured or checkout fails with
# "`key_id` or `oauthToken` is mandatory".
# ---------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# Support destination for every "Connect Support" / "Connect Us" / "Get in
# Touch" control in the app (there are 12, all sharing one <SupportLink>).
#
# Set this to route them at a mailbox. Leave it blank and they fall back to the
# foundation's public site (ORG.site) — a real destination rather than a guessed
# address that would bounce.
# ---------------------------------------------------------------------------
VITE_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Social profiles for the landing-page footer. Full URLs, e.g.
# https://instagram.com/ramdootfoundation
#
# An icon with no URL is NOT rendered — these used to be href="#" links that
# scrolled to the top, so an unset one now simply leaves the footer shorter
# rather than shipping a broken link.
# ---------------------------------------------------------------------------
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_LINKEDIN=
